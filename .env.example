# BurnGuard AI Environment Configuration Example

# Database Connection (Defaults to SQLite for local development or /tmp fallback on Vercel)
# For production PostgreSQL on Vercel (Neon / Supabase / Vercel Postgres):
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/burnguard_db?sslmode=require
DATABASE_URL=sqlite:///burnguard.db

# Model & Data Paths (Defaults to project root models/ and data/raw/)
MODEL_DIR=models
DATA_RAW_DIR=data/raw

# Hybrid Risk Scoring Engine Weights
ANOMALY_WEIGHT=0.40
EARLY_DRIFT_WEIGHT=0.25
PREDICTED_RISK_WEIGHT=0.25
LOT_DEVIATION_WEIGHT=0.10

# Frontend API Endpoint (Defaults to /api for Vercel unified deployment, or http://localhost:8000/api for standalone local dev)
VITE_API_URL=/api

# Optional Third-Party Services (e.g. Convai AI Chatbot integration)
# CONVAI_API_KEY=your_convai_api_key_here
